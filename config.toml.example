[discord]
bot_token = "${DISCORD_BOT_TOKEN}"
allowed_channels = ["1234567890"]
# allowed_users = ["<YOUR_DISCORD_USER_ID>"]  # empty or omitted = allow all users

[agent]
command = "kiro-cli"
args = ["acp", "--trust-all-tools"]
working_dir = "/home/agent"

# [agent]
# command = "claude"
# args = ["--acp"]
# working_dir = "/home/agent"
# env = { ANTHROPIC_API_KEY = "${ANTHROPIC_API_KEY}" }

# [agent]
# command = "codex"
# args = ["--acp"]
# working_dir = "/home/agent"
# env = { OPENAI_API_KEY = "${OPENAI_API_KEY}" }

# [agent]
# command = "gemini"
# args = ["--acp"]
# working_dir = "/home/agent"
# env = { GEMINI_API_KEY = "${GEMINI_API_KEY}" }

[pool]
max_sessions = 10
session_ttl_hours = 24

[reactions]
enabled = true
remove_after_reply = false

[reactions.emojis]
queued = "👀"
thinking = "🤔"
tool = "🔥"
coding = "👨💻"
web = "⚡"
done = "🆗"
error = "😱"

[reactions.timing]
debounce_ms = 700
stall_soft_ms = 10000
stall_hard_ms = 30000
done_hold_ms = 1500
error_hold_ms = 2500

# Speech-to-text for voice messages (also used by the podcast feature below).
# See docs/stt.md. Auto-detects GROQ_API_KEY when base_url is Groq.
# [stt]
# enabled = true
# api_key = "${GROQ_API_KEY}"

# Apple Podcast summarization. Paste an https://podcasts.apple.com/... link and
# the agent receives the episode transcript + a summary instruction. See
# docs/podcast.md. Transcription reuses the [stt] provider above; the audio
# fallback needs ffmpeg on PATH.
# [podcast]
# enabled = true
# max_minutes = 90                  # cap on audio sent to STT in the fallback path
# ffmpeg_path = "ffmpeg"
# summary_prompt = "以下是一集 Podcast 的逐字稿。請用繁體中文輸出 TL;DR + 3~7 條重點。"
